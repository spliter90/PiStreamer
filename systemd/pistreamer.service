[Unit]
Description=PiStreamer Web and streaming service
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
SupplementaryGroups=video audio
WorkingDirectory=/opt/pistreamer/current
Environment=PISTREAMER_CONFIG=/etc/pistreamer/config.yaml
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Europe/Berlin
RuntimeDirectory=pistreamer
RuntimeDirectoryMode=0775
RuntimeDirectoryPreserve=restart
ExecStart=/usr/bin/env /opt/pistreamer/current/.venv/bin/python /opt/pistreamer/current/run.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/pistreamer/data /etc/pistreamer /run/pistreamer
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
